{
  "name": "dsh-preset-agent-manager",
  "version": "0.1.0",
  "description": "Preset agent manager for DeepSeek Harness: a sidebar admin panel plus the preset_agent_dispatch delegation tool over per-agent plugin whitelists.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/impl.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "TESTING.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "agent",
    "subagent",
    "preset-agent",
    "delegation"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
